      "id": "9012baa8-d70d-4809-8938-99db3a90fb60",
      "name": "Prepare Update"
    },
    {
      "parameters": {
        "jsCode": "const clean = v => String(v ?? '').trim();\n\nconst changed = [];\n\nfor (const { json: r } of $input.all()) {\n  const name = clean(r.Name);\n  const course = clean(r.Course);\n  const status = clean(r.Status);\n\n  // Skip empty or half-filled rows\n  if (!name || !course || !status) continue;\n\n  const current = `${name} | ${course} | ${status}`;\n  const lastSent = clean(r['Last Sent']);\n\n  // Skip rows that haven't changed\n  if (current === lastSent) continue;\n\n  changed.push({\n    row_number: r.row_number,\n    type: lastSent ? 'Updated' : 'New',\n    name, course, status, current\n  });\n}\n\n// Nothing new: don't send an email\nif (changed.length === 0) {\n  return [{ json: { hasData: false } }];\n}\n\nconst details = changed.map((r, i) =>\n`${i + 1}. ${r.type} record\n- Name: ${r.name}\n- Course: ${r.course}\n- Status: ${r.status}`\n).join('\\n\\n');\n\nconst body = `Hi,\n\nHere is the latest data from the sheet:\n\n${details}\n\nTotal new or updated records: ${changed.length}\n\nRegards,\nYour Automation Bot`;\n\nreturn [{\n  json: {\n    hasData: true,\n    subject: 'Data Summary from Google Sheet',\n    body,\n    sentRows: changed.map(r => ({\n      row_number: r.row_number,\n      lastSent: r.current\n    }))\n  }\n}];"
      },
