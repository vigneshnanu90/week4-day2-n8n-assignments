      ],
      "id": "f2cb3d06-b438-420b-a916-a1afe46c4bd6",
      "name": "Capture Recipe"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let reply = String($json.text ?? '').trim();\n\nreply = reply\n  .replace(/^\\s*[-*]\\s+/gm, '• ')                // bullets\n  .replace(/^#{1,6}\\s+(.*)$/gm,\n    (_, title) => `*${title.replace(/\\*/g, '')}*`) // headings\n  .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*');             // Slack bold\n\nif (!reply) {\n  reply = 'Sorry, I could not create the list. Please try again.';\n}\n\nreturn {\n  json: {\n    reply,\n    channel: $('Capture Recipe').item.json.channel\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -16
      ],
      "id": "90109a14-fc4d-4801-bbff-84b91afc55aa",
      "name": "Format Reply"
    },
