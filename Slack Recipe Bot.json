          "assignments": [
            {
              "id": "d0a18687-9f3b-405b-b5df-73a32546e9c9",
              "name": "recipe",
              "value": "={{ ($json.text || '').replace(/<@[A-Z0-9]+>/g, '').trim() }}",
              "type": "string"
            },
            {
              "id": "0f41143a-13ca-4114-9398-b6704b567813",
              "name": "channel",
              "value": "={{ $json.channel }}",
